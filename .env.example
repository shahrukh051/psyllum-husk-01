# Server
PORT=3000
ENVIRONMENT=production
WORKERS=12

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# SQLite
DB_PATH=data/husk.db

# ── Email (SMTP) — fill in to enable order confirmation & contact emails ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=Husk & Co. <your@gmail.com>

# ── Razorpay — fill in to enable payment orders ──
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── Admin Panel — credentials to access /admin ──
ADMIN_USERNAME=shahrukh
ADMIN_PASSWORD=1404
ADMIN_SECRET_KEY=change-this-to-a-random-secret-for-jwt-signing
